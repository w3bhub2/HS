Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Canonical host and HTTPS. Confirm this rule at the host before deployment.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^healspoc\.com$ [NC]
RewriteRule ^ https://healspoc.com%{REQUEST_URI} [R=301,L,NE]

# Preserve the observed legacy treatment URLs with permanent, relevant redirects.
RewriteRule ^gastric-balloon-surgery-cost-in-india/?$ /treatments/weight-loss/ [R=301,L]
RewriteRule ^gastric-bypass-surgery-cost-in-india/?$ /treatments/weight-loss/ [R=301,L]
RewriteRule ^lap-band-surgery-cost-in-india/?$ /treatments/weight-loss/ [R=301,L]
RewriteRule ^sleeve-gastrectomy-surgery-cost-in-india/?$ /treatments/weight-loss/ [R=301,L]
RewriteRule ^kyphosis-surgery-cost-in-india/?$ /treatments/brain-spine/ [R=301,L]
RewriteRule ^brain-cancer-treatment-cost-in-india/?$ /treatments/cancer-care/ [R=301,L]
RewriteRule ^goiter-removal-surgery-cost-in-india/?$ /treatments/endocrine-care/ [R=301,L]
RewriteRule ^about$ /about/ [R=301,L]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]

# Retire default WordPress content and public author enumeration.
RewriteRule ^hello-world/?$ - [G,L]
RewriteRule ^author/admingeekspoc-com/?$ - [G,L]
RewriteRule ^(?:wp-admin|wp-json)(?:/|$) - [R=404,L]
RewriteRule ^(?:xmlrpc\.php|wp-login\.php|wp-comments-post\.php)$ - [G,L]

# Serve static assets normally and route application paths to the React entry.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; connect-src 'self' https://api.web3forms.com; img-src 'self' data:; font-src 'self' data:; style-src 'self'; style-src-attr 'none'; script-src 'self' 'sha256-Q73obPoWPwHPliKTiL3sL8YHVSeyEbvJkb+EOuUwo80='; script-src-attr 'none'; upgrade-insecure-requests"
</IfModule>