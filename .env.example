# Create this Web3Forms access key for hello@healspoc.com and restrict it to healspoc.com.
# This browser-side access key is intentionally public per Web3Forms' static-site API.
VITE_WEB3FORMS_ACCESS_KEY=
# GitHub Pages project-site build values. The workflow supplies these automatically.
VITE_BASE_PATH=/HS/
VITE_SITE_URL=https://w3bhub2.github.io/HS